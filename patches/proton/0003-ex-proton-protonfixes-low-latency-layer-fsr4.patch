diff --git a/extras/build-low_latency_layer.mk b/extras/build-low_latency_layer.mk
new file mode 100644
index 000000000..ff1ac3fc5
--- /dev/null
+++ b/extras/build-low_latency_layer.mk
@@ -0,0 +1,50 @@
+##
+## low_latency_layer (EX-Proton)
+##
+## Vulkan layer from Korthos-Software/low_latency_layer, enabled at run time
+## with LOW_LATENCY_LAYER=1. Build rules follow Proton-GE's
+## vklayers/build-low_latency_layer.mk and build-vulkan-utility-libraries.mk.
+## Only built when both source trees are present (scripts/prepare.sh clones
+## them from extras.conf).
+
+ifneq ($(wildcard $(SRC)/extras/low_latency_layer/CMakeLists.txt),)
+ifneq ($(wildcard $(SRC)/extras/Vulkan-Utility-Libraries/CMakeLists.txt),)
+
+VULKAN_UTILITY_LIBRARIES_CMAKE_ARGS = \
+  -DCMAKE_BUILD_TYPE=release
+
+VULKAN_UTILITY_LIBRARIES_DEPENDS = vulkan-headers
+
+$(eval $(call rules-source,vulkan-utility-libraries,$(SRCDIR)/extras/Vulkan-Utility-Libraries))
+$(eval $(call rules-cmake,vulkan-utility-libraries,x86_64,unix))
+$(eval $(call rules-cmake,vulkan-utility-libraries,aarch64,unix))
+
+## Only used to build low_latency_layer; it is not shipped.
+$(OBJ)/.vulkan-utility-libraries-x86_64-dist:
+	touch $@
+$(OBJ)/.vulkan-utility-libraries-aarch64-dist:
+	touch $@
+
+LOW_LATENCY_LAYER_CMAKE_ARGS = \
+  -DCMAKE_BUILD_TYPE=release
+
+LOW_LATENCY_LAYER_DEPENDS = vulkan-headers vulkan-utility-libraries
+
+$(eval $(call rules-source,low_latency_layer,$(SRCDIR)/extras/low_latency_layer))
+$(eval $(call rules-cmake,low_latency_layer,x86_64,unix))
+$(eval $(call rules-cmake,low_latency_layer,aarch64,unix))
+
+$(OBJ)/.low_latency_layer-x86_64-post-build:
+	mkdir -p $(DST_DIR)/share/low_latency_layer/implicit_layer.d/
+	cp -a $(LOW_LATENCY_LAYER_x86_64_DST)/share/vulkan/implicit_layer.d/low_latency_layer.json $(DST_DIR)/share/low_latency_layer/implicit_layer.d/
+	touch $@
+
+$(OBJ)/.low_latency_layer-aarch64-post-build:
+	mkdir -p $(DST_DIR)/share/low_latency_layer/implicit_layer.d/
+	cp -a $(LOW_LATENCY_LAYER_aarch64_DST)/share/vulkan/implicit_layer.d/low_latency_layer.json $(DST_DIR)/share/low_latency_layer/implicit_layer.d/
+	touch $@
+
+all-dist: low_latency_layer
+
+endif # extras/Vulkan-Utility-Libraries present
+endif # extras/low_latency_layer present
diff --git a/extras/build-protonfixes.mk b/extras/build-protonfixes.mk
new file mode 100644
index 000000000..47c23cc54
--- /dev/null
+++ b/extras/build-protonfixes.mk
@@ -0,0 +1,44 @@
+##
+## protonfixes (EX-Proton)
+##
+## open-wine-components/umu-protonfixes: per-game fixes and the upscaler
+## (FSR4) download helper, installed as <build>/protonfixes and imported by
+## the launcher script. Build rules follow Proton-GE's Makefile.in.
+## Only built when the source tree is present (scripts/prepare.sh clones it
+## from extras.conf).
+
+ifneq ($(wildcard $(SRC)/extras/protonfixes/Makefile),)
+
+$(eval $(call rules-source,protonfixes,$(SRCDIR)/extras/protonfixes))
+$(eval $(call rules-common,protonfixes,x86_64,unix))
+$(eval $(call rules-common,protonfixes,aarch64,unix))
+
+$(OBJ)/.protonfixes-x86_64-build:
+	cd $(PROTONFIXES_SRC) && \
+	env $(PROTONFIXES_x86_64_ENV) BUILD=$(PROTONFIXES_x86_64_OBJ) TARGET_ARCH=$(TARGET_ARCH) make
+	cd $(PROTONFIXES_SRC) && \
+	env $(PROTONFIXES_x86_64_ENV) BUILD=$(PROTONFIXES_x86_64_OBJ) DIST=$(PROTONFIXES_x86_64_DST) TARGET_ARCH=$(TARGET_ARCH) make install
+	touch $@
+
+$(OBJ)/.protonfixes-aarch64-build:
+	cd $(PROTONFIXES_SRC) && \
+	env $(PROTONFIXES_aarch64_ENV) BUILD=$(PROTONFIXES_aarch64_OBJ) TARGET_ARCH=$(TARGET_ARCH) make
+	cd $(PROTONFIXES_SRC) && \
+	env $(PROTONFIXES_aarch64_ENV) BUILD=$(PROTONFIXES_aarch64_OBJ) DIST=$(PROTONFIXES_aarch64_DST) TARGET_ARCH=$(TARGET_ARCH) make install
+	touch $@
+
+PROTONFIXES_TARGET := $(addprefix $(DST_BASE)/,protonfixes)
+
+$(OBJ)/.protonfixes-x86_64-dist:
+	mkdir -p $(PROTONFIXES_TARGET)
+	rsync --delete -arx $(PROTONFIXES_x86_64_DST)/ $(PROTONFIXES_TARGET)
+	touch $@
+
+$(OBJ)/.protonfixes-aarch64-dist:
+	mkdir -p $(PROTONFIXES_TARGET)
+	rsync --delete -arx $(PROTONFIXES_aarch64_DST)/ $(PROTONFIXES_TARGET)
+	touch $@
+
+all-dist: protonfixes
+
+endif # extras/protonfixes present
