+/* Convert with libswscale's slice threading. libavcodec decodes on several threads
+ * but sws_scale() converts on the calling thread only, which is too slow for high
+ * resolution video (winegstreamer's videoconvert uses every core). Threading needs
+ * a context created with the "threads" option and sws_scale_frame().
+ * Returns false when the caller should use the single-threaded scaler instead. */
+static bool scale_video_frame_threaded( struct unix_transform *t, const AVFrame *frame,
+                                        int src_width, int src_height, int sws_flags )
+{
+    AVFrame *out = t->sws_frame;
+    int params[7] = {src_width, src_height, frame->format, out->width, out->height, out->format, sws_flags};
+    int threads = min( av_cpu_count(), 16 );
+
+    if (t->sws_mt_failed || threads < 2) return false;
+    if ((int64_t)src_width * src_height < 1280 * 720) return false;
+
+    if (!t->sws_mt || memcmp( params, t->sws_mt_params, sizeof(params) ))
+    {
+        if (t->sws_mt) sws_freeContext( t->sws_mt );
+        if (!(t->sws_mt = sws_alloc_context())) goto failed;
+        t->sws_mt->src_w = src_width;
+        t->sws_mt->src_h = src_height;
+        t->sws_mt->src_format = frame->format;
+        t->sws_mt->dst_w = out->width;
+        t->sws_mt->dst_h = out->height;
+        t->sws_mt->dst_format = out->format;
+        t->sws_mt->flags = sws_flags;
+        t->sws_mt->threads = threads;
+        if (sws_init_context( t->sws_mt, NULL, NULL ) < 0) goto failed;
+        memcpy( t->sws_mt_params, params, sizeof(params) );
+        TRACE( "created threaded scaler %dx%d fmt %d -> %dx%d fmt %d, threads %d\n", src_width, src_height,
+               frame->format, out->width, out->height, out->format, t->sws_mt->threads );
+    }
+
+    if (!t->sws_mt_src && !(t->sws_mt_src = av_frame_alloc())) goto failed;
+    av_frame_unref( t->sws_mt_src );
+    if (av_frame_ref( t->sws_mt_src, frame ) < 0) goto failed;
+    /* The scaler takes the whole input frame: limit it to the visible size. */
+    t->sws_mt_src->width = src_width;
+    t->sws_mt_src->height = src_height;
+
+    if (sws_scale_frame( t->sws_mt, out, t->sws_mt_src ) < 0)
+    {
+        av_frame_unref( t->sws_mt_src );
+        goto failed;
+    }
+    av_frame_unref( t->sws_mt_src );
+    return true;
+
+failed:
+    WARN( "threaded scaling failed, using the single-threaded scaler\n" );
+    if (t->sws_mt) sws_freeContext( t->sws_mt );
+    t->sws_mt = NULL;
+    t->sws_mt_failed = true;
+    return false;
+}
