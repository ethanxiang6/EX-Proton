piper: use a prepared ONNX Runtime when one is present.

piper-phonemize downloads ONNX Runtime 1.14.1 from github.com/microsoft/onnxruntime
release assets, which now return 404. scripts/prepare.sh places the same release,
taken from Microsoft's Microsoft.ML.OnnxRuntime 1.14.1 NuGet package, under
ex-onnxruntime/; pass it to piper-phonemize as ONNXRUNTIME_DIR (which it already
accepts). Without that directory nothing changes.

Written for EX-Proton.

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 6e41c83..476b719 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -62,11 +62,25 @@ endif()
 
 if(NOT DEFINED PIPER_PHONEMIZE_DIR)
   set(PIPER_PHONEMIZE_DIR "${CMAKE_CURRENT_BINARY_DIR}/pi")
+  # EX-Proton: piper-phonemize downloads ONNX Runtime from
+  # github.com/microsoft/onnxruntime releases, which no longer resolve. When
+  # scripts/prepare.sh has placed the same release (from Microsoft's NuGet
+  # package) under ex-onnxruntime/, use that copy instead of downloading.
+  set(EX_PROTON_ONNXRUNTIME_ARGS "")
+  if(CMAKE_SYSTEM_PROCESSOR STREQUAL aarch64)
+    set(EX_PROTON_ONNXRUNTIME_DIR "${CMAKE_CURRENT_SOURCE_DIR}/ex-onnxruntime/onnxruntime-linux-aarch64-1.14.1")
+  elseif(CMAKE_SYSTEM_PROCESSOR STREQUAL x86_64)
+    set(EX_PROTON_ONNXRUNTIME_DIR "${CMAKE_CURRENT_SOURCE_DIR}/ex-onnxruntime/onnxruntime-linux-x64-1.14.1")
+  endif()
+  if(DEFINED EX_PROTON_ONNXRUNTIME_DIR AND EXISTS "${EX_PROTON_ONNXRUNTIME_DIR}/include/onnxruntime_cxx_api.h")
+    message(STATUS "EX-Proton: using ONNX Runtime from ${EX_PROTON_ONNXRUNTIME_DIR}")
+    set(EX_PROTON_ONNXRUNTIME_ARGS "-DONNXRUNTIME_DIR:PATH=${EX_PROTON_ONNXRUNTIME_DIR}")
+  endif()
   ExternalProject_Add(
     piper_phonemize_external
     PREFIX "${CMAKE_CURRENT_BINARY_DIR}/p"
     URL "https://github.com/shaunren/piper-phonemize/archive/refs/heads/pic.zip"
-    CMAKE_ARGS -DCMAKE_INSTALL_PREFIX:PATH=${PIPER_PHONEMIZE_DIR}
+    CMAKE_ARGS -DCMAKE_INSTALL_PREFIX:PATH=${PIPER_PHONEMIZE_DIR} ${EX_PROTON_ONNXRUNTIME_ARGS}
   )
   add_dependencies(piper piper_phonemize_external)
   add_dependencies(test_piper piper_phonemize_external)
